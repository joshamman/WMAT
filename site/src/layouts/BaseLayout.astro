---
import '../styles/global.css';
import { business, person } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Site-relative path or absolute URL; defaults to the branded social card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** e.g. 'noindex, follow' — the meta tag is omitted when unset. */
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra JSON-LD nodes (FAQPage, BlogPosting, Service, BreadcrumbList…), one <script> each. */
  schema?: Record<string, unknown>[];
}
const {
  title = 'Art Therapy in West Olive, MI — Heal Through Creativity',
  description = 'Board-certified art therapy for all ages — in person in West Olive, Grand Rapids, Holland, Muskegon & Grand Haven, and online across Michigan.',
  ogType = 'website',
  ogImage = '/assets/images/og-default.png',
  ogImageAlt = 'West Michigan Art Therapy — watercolor lakeshore card reading “Heal through creativity”',
  robots,
  publishedTime,
  modifiedTime,
  schema = [],
} = Astro.props;

// Dimensions are only known for the default card; custom images omit the tags.
const isDefaultOg = !Astro.props.ogImage;
const ogImageWidth = Astro.props.ogImageWidth ?? (isDefaultOg ? 1200 : undefined);
const ogImageHeight = Astro.props.ogImageHeight ?? (isDefaultOg ? 630 : undefined);
const ogImageAbs = new URL(ogImage, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLdBlocks = [business(), person(), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FCF8F0" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="West Michigan Art Therapy" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="West Michigan Art Therapy — From the studio"
      href={new URL('/rss.xml', Astro.site).href}
    />
    {jsonLdBlocks.map((node) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
    ))}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R0JV4T0QSJ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R0JV4T0QSJ');
    </script>
  </head>
  <body>
    <!-- Watercolor turbulence filters (referenced by .wash / .wmat-wash) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
      <filter id="wc-edge" x="-25%" y="-25%" width="150%" height="150%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.018" numOctaves="3" seed="7" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="34" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
      <filter id="wc-soft" x="-40%" y="-40%" width="180%" height="180%">
        <feTurbulence type="fractalNoise" baseFrequency="0.009" numOctaves="2" seed="3" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="56" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs></svg>
    <slot />
  </body>
</html>
