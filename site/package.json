{
  "name": "wmat-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "West Michigan Art Therapy — static site (Astro)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "rm -rf .astro dist",
    "rebuild": "npm run clean && astro build",
    "check:contrast": "node scripts/wcag-contrast.mjs",
    "check:rendered": "node scripts/wcag-rendered.mjs",
    "check": "node scripts/wcag-contrast.mjs && astro build && node scripts/wcag-rendered.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "make:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.6.0"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
